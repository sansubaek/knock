# Supabase > Project Settings > API 에서 복사
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용. 절대 NEXT_PUBLIC_ 붙이지 말 것. 채팅·깃허브에 올리지 말 것
SUPABASE_SERVICE_ROLE_KEY=

# 아무 긴 랜덤 문자열 (예: 터미널에서 openssl rand -hex 32). 한 번 정하면 바꾸지 말 것
KNOCK_CODE_SECRET=
VISITOR_HASH_SALT=

# 실제 도메인 (QR에 들어가는 주소). 끝에 / 없이
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 카카오 로그인 준비되면 on
NEXT_PUBLIC_KAKAO_LOGIN=off
